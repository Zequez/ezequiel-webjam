mixin FancyLink(link)
  a(href=link
    cursor-pointer h-6 m1 pt.3
    text="3" rounded-1 flex-cc 
    uppercase
    transition-200
    hover="bg-white/30 bg-gradient-to-br from-white/10 shadow-[0_1px_0] shadow-white/40 transition-0"
    tracking-wider font-mono font-semibold px3
    text-shadow="[0_1px_0_#0004]"
    gap-1.5
  )
    block

mixin WrapBox()
  div(w-full grid gap-3 md:gap-6 cols-1 md:cols-2)
    block
    
html(h-full)
  head
    title Ezequiel Adrián Schwartzman
    meta(name="webjam-source" content="https://github.com/zequez/ezequiel-webjam")
    meta(name="viewport" content="width=device-width, initial-scale=1")
  body(bg-lime-950 flex-col min-h-full)
    div(h8.5 w-full bg-lime-500 flex text-white b-b-2 b-lime-900 )
      +FancyLink("https://gaia.webjam.space")
        span(mb.7) ◀
        span Gaia
      a(
        href="https://ezequielschwartzman.org"
        flex-grow text-center uppercase flex-cc text-3 md:text-4
  
        font-mono font-semibold text-shadow="[0_1px_0_#000]"
        )
        | Ezequiel Adrián Schwartzman
      +FancyLink("https://gaia.webjam.space")
        span Gaia
        span(mb.7) ▶

    main(w-full p6 max-w-screen-md mx-auto)
      div(flex-grow w-full bg-white rounded-lg p3 md:p6 flex-cc flex-col gap-3 md:gap-6 bg-linear-to-b from="white/20")
        +WrapBox
          img(src="images/ezequiel-humano/sm.webp" rounded-2 w-full)
          div(uppercase font-serif text-center flex-cc w-full text-30) Hey 
        +WrapBox
          div(flex-cc text-center w-full flex-col)
            | My name is Ezequiel Adrián Schwartzman
            div I'm an open source commons developer working on Gaia's Team
            div
              | I'm creating the Web Jam Editor
              a(href="https://webjam.space" block text-blue underline) https://webjam.space
              a(href="https://github.com/zequez/web-jam-editor" block text-blue underline) https://github.com/zequez/web-jam-editor
          img(src="images/ezequiel-mate/sm.webp" max-w-full mx-auto rounded-2)
          
        +WrapBox
          img(src="images/ezequiel-mate-termo/sm.webp" max-w-full mx-auto rounded-2)
          div(text-center flex-cc)
            div
              span You can find my previous work at 
              a(href="https://web7.ezequielschwartzman.org" text-blue underline) https://web7.ezequielschwartzman.org
        div(grid cols-2 gap-3 md:gap-6)
          img(src="images/ezequiel-karina/sm.webp" max-w-full rounded-2 object-cover)
          img(src="images/ezequiel-nami/sm.webp" max-w-full rounded-2 object-cover)
        div(text-center px6 flex-cc flex-col grow)
          | I'm also a human being with a human face.
          | You can find mi living at Casa Nami co-living in Mar del Plata, Argentina, where I'm holding space for evolutionary convivency
          div
            span Contact me on 
            a(href="https://t.me/ezequielschwartzman" text-blue underline) Telegram
            span  or  
            a(href="https://wa.me/5492235235568" text-blue underline) Whatsapp
        a(href="https://forms.gle/pkvnMysirAUopCzj6" w-full h-20 flex-cc text-6/12 bg-yellow-400 hover:bg-yellow-300 text-white rounded-2 font-mono text-center text-shadow="[0_1px_0_#0007]")
          | Consider supporting WebJam project
        
      