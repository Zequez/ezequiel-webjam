html(h-full="")
  head
    link(
      href="style.css" 
      rel="stylesheet"
      )
    title Ezequiel Adrián Schwartzman
    meta(
      content="https://github.com/zequez/ezequiel-webjam" 
      name="webjam-source"
      )
    meta(
      content="width=device-width, initial-scale=1"
      name="viewport"
      )
    link(
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌟</text></svg>" 
      type="image/svg+xml" 
      rel="icon"
      )
  body[flex-col min-h-full bg-[url(./images/old-moon-invert/md.webp)] bg-slate-400]
    div[flex flex-col gap-1 max-w-screen-sm mx-auto p1 sm:p6]
      div[flex gap-1 sm:gap-3]
        div[shrink-0 w-1/2 bg-white/0 shadow-sm sm:w-1/3]
          img[h-full rounded-1](src="./images/ezequiel-humano/md.webp")
        div[flex flex-col grow gap-1 font-mono whitespace-nowrap sm:gap-3]
          div[
            flex-cc h-full px1 py3 font-bold text-[5vw] lh-160% sm:text-5/8 text-center
            bg-black text-black relative rounded-1 shadow-sm sm:h-30 sm:px3
          ]
            canvas[absolute block w-100% h-100% top-0 left-0](id="title-bg")
            script.
              const C = document.getElementById('title-bg');
              const c = C.getContext('2d');
              const {width, height} = C.getBoundingClientRect()
              C.width = width;
              C.height = height;
              c.fillStyle   = 'white';
              c.beginPath()
              const [x, y, radius] = [20, 20, 2]
              c.arc(x, y, radius, 0, Math.PI * 2)
              c.fill()
            //div[absolute bg-gradient-to-t from-black/5 inset-4  bg-white rounded-3 flex-cc] Ezequiel <br class="sm:hidden"/> Adrián <br/> Schwartzman
          div[grow hidden px3 text-center bg-white rounded-1 shadow-sm sm:flex-cc]
            span Free Software Developer
          div[grow hidden px3 text-center bg-white rounded-1 shadow-sm sm:flex-cc]
            span
              | Possibilitator 
              i in training
      div[flex flex-col gap-1 font-mono sm:hidden]
        div[flex-cc grow px3 text-center bg-white h12 rounded-1]
          span Free Software Developer
        div[flex-cc grow px3 text-center bg-white h12 rounded-1]
          span
            | Possibilitator 
            i in training
    div[
      flex-cc relative h-24 p6 font-mono text-lime-300
      b-b-4 b-b-black/20 b-t-1 b-t-white/30 bg-gray-800 bg-linear-to-t from-black/7 shadow-[0_2px_3px_#0005]
    ]
      div[absolute inset-x-0 top-1px h-1px bg-white/15]
      // span Web Jam 0.2.0 is out.  <a class="underline" href="https://github.com/Zequez/web-jam-editor/blob/main/CHANGELOG.md">Check changelog</a>
    mixin ROW(h)
      div[flex gap-1 h-${h} sm:gap-3]
        block
    mixin CARD(w)
      div[
        flex-cc px-2 w-${w} break-all font-mono text-6
        @container bg-gray-50 bg-linear-to-t from-black/5 overflow-hidden rounded-1 shadow-[0_2px_0_#000,0_1px_4px_#0006]
        sm:px-3 sm:text-8
      ]
        block
    div[flex flex-col gap-1 max-w-screen-2xl mx-auto p1 sm:gap-3 sm:p6] 
      +ROW(40)
        +CARD("1/3") About Me
        +CARD("2/3")  Web Jam
      +ROW(40)
        +CARD("1/2")  Curriculum Vitae
        +CARD("1/2")  Web Portfolio
      +ROW(20)
        +CARD("1/1")  Web y Mates Club
      +ROW(40)
        +CARD("1/2")  Web Training
        +CARD("1/2")  Web Engineering
      +ROW(40)
        +CARD("1/2")  Co-living Spaceholding
        +CARD("1/2")  Emotional Healing Processing
      +ROW(40)
        +CARD("1/4")  Gaia Stickers
        +CARD("1/4")  Writing
        +CARD("1/4")  Cooking
        +CARD("1/4")  Videoing
    div[flex-cc h-48 font-mono text-white bg-black/40 bg-linear-to-t from-black/20]
      | Is this the end?