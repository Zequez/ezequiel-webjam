mixin EmojiFavicon(emoji)
  link(
    rel="icon"
    type="image/svg+xml"
    href=`data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90">${emoji}</text></svg>`
  )

mixin Greeting(name)
  p[text-white] Hello, #{name}!

mixin FancyLink(link)
  a[
    flex-cc gap-1.5 h-6 pt.3 px3 cursor-pointer
    font-mono font-semibold text-3 text-shadow-[0_1px_0_#0004] tracking-wider uppercase
    m1 rounded-1 transition-200
    hover:(bg-white/30 bg-gradient-to-br from-white/10 shadow-[0_1px_0] shadow-white/40 transition-0)
  ](href=link)
    block

mixin Ring(leftText, leftLink, centerText, centerLink, rightText, rightLink)
  div[flex w-full text-white b-b-2 b-lime-900 bg-lime-500 h8.5]
    +FancyLink(leftLink)
      span[mb.7] ◀
      span= leftText
    a[
      flex-cc flex-grow
      font-mono font-semibold text-3 text-center text-shadow-[0_1px_0_#000] uppercase
      md:text-4
    ](href=centerLink)= centerText
    +FancyLink(rightLink)
      span= rightText
      span[mb.7] ▶

mixin WrapBox()
  div[grid gap-3 w-full cols-1 md:gap-6 sm:cols-2]
    block

mixin Img(src)
  img[w-full b-black/50 b-t-1 rounded-2 shadow-[0_1.5px_0_1px] shadow-gray-600](src=src)

